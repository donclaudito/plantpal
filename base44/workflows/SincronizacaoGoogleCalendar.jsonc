{
  "description": "Mant\u00e9m os plant\u00f5es e cirurgias sincronizados com o Google Calendar a cada 6 horas, com lembretes autom\u00e1ticos.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizacao_google_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sincronizar_calendario": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleCalendar",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar Google Calendar",
            "description": "Cria e atualiza os eventos de plant\u00f5es e cirurgias"
          }
        }
      }
    ]
  },
  "name": "Sincroniza\u00e7\u00e3o Google Calendar",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}