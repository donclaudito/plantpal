{
  "description": "Envia todos os dias, \u00e0s 7h, um e-mail com os plant\u00f5es e cirurgias de hoje e de amanh\u00e3.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lembretes_agenda",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_lembretes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAgendaReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar lembretes da agenda",
            "description": "E-mail di\u00e1rio com hoje e amanh\u00e3"
          }
        }
      }
    ]
  },
  "name": "Lembretes da Agenda",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}