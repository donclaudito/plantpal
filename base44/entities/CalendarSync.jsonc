{
  "name": "CalendarSync",
  "type": "object",
  "properties": {
    "record_type": {
      "type": "string",
      "enum": [
        "Shift",
        "Procedimento"
      ],
      "description": "Tipo de registo ligado ao evento do Google Calendar"
    },
    "record_id": {
      "type": "string",
      "description": "ID do plant\u00e3o ou cirurgia sincronizado"
    },
    "google_event_id": {
      "type": "string",
      "description": "ID do evento criado no Google Calendar"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Data do evento usada para controlar a sincroniza\u00e7\u00e3o"
    }
  },
  "required": [
    "record_type",
    "record_id",
    "google_event_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}