{
  "name": "Procedimento",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "Cirurgia",
        "Consulta"
      ],
      "description": "Tipo de procedimento"
    },
    "doctor_id": {
      "type": "string",
      "description": "ID do m\u00e9dico"
    },
    "doctor_name": {
      "type": "string",
      "description": "Nome do m\u00e9dico"
    },
    "hospital_id": {
      "type": "string",
      "description": "ID do hospital"
    },
    "hospital_name": {
      "type": "string",
      "description": "Nome do hospital"
    },
    "paciente": {
      "type": "string",
      "description": "Nome do paciente extra\u00eddo do prontu\u00e1rio"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do procedimento"
    },
    "tipo_pagamento": {
      "type": "string",
      "enum": [
        "SUS",
        "Convenio",
        "Particular"
      ],
      "description": "Tipo de pagamento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do procedimento"
    },
    "quantidade": {
      "type": "number",
      "minimum": 1,
      "default": 1,
      "description": "Quantidade realizada no atendimento"
    },
    "valor": {
      "type": "number",
      "description": "Valor unit\u00e1rio do procedimento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "ficha": {
      "type": "object",
      "description": "Dados da folha de sala / ficha da cirurgia lidos na foto",
      "properties": {
        "mae": {
          "type": "string",
          "description": "Nome da m\u00e3e do paciente"
        },
        "prontuario": {
          "type": "string",
          "description": "N\u00famero do prontu\u00e1rio"
        },
        "data_nascimento": {
          "type": "string",
          "description": "Data de nascimento do paciente"
        },
        "atendimento": {
          "type": "string",
          "description": "N\u00famero do atendimento"
        },
        "prescricao": {
          "type": "string",
          "description": "N\u00famero da prescri\u00e7\u00e3o"
        },
        "cirurgia_codigo": {
          "type": "string",
          "description": "C\u00f3digo da cirurgia"
        },
        "sexo": {
          "type": "string",
          "description": "Sexo do paciente"
        },
        "duracao": {
          "type": "string",
          "description": "Dura\u00e7\u00e3o da cirurgia"
        },
        "carater_cirurgico": {
          "type": "string",
          "description": "Car\u00e1ter cir\u00fargico (eletiva, urg\u00eancia)"
        },
        "setor": {
          "type": "string",
          "description": "Setor do internamento"
        },
        "acomodacao": {
          "type": "string",
          "description": "Acomoda\u00e7\u00e3o (enfermaria, apartamento)"
        },
        "tipo_internamento": {
          "type": "string",
          "description": "Tipo de internamento"
        }
      }
    },
    "anexos": {
      "type": "array",
      "description": "Documentos e fotos do prontu\u00e1rio enviados para a cirurgia",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome do ficheiro"
          },
          "file_uri": {
            "type": "string",
            "description": "Refer\u00eancia privada do ficheiro"
          },
          "enviado_em": {
            "type": "string",
            "format": "date-time",
            "description": "Data do envio"
          }
        }
      }
    },
    "concluido": {
      "type": "boolean",
      "default": false,
      "description": "Procedimento conclu\u00eddo; ao marcar, o recibo \u00e9 enviado automaticamente pelo Gmail"
    },
    "recibo_enviado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que o recibo em PDF foi enviado pelo Gmail"
    },
    "recibo_enviado_para": {
      "type": "string",
      "description": "E-mail que recebeu o recibo do procedimento"
    }
  },
  "required": [
    "tipo",
    "doctor_name",
    "hospital_name",
    "data",
    "tipo_pagamento",
    "valor"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "email": "clauorenstein@gmail.com"
              }
            },
            {
              "created_by": {
                "$in": [
                  "clauorenstein@gmail.com",
                  "quiclauorenstein@gmail.com",
                  "testeclauorenstein@gmail.com"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "email": "quiclauorenstein@gmail.com"
              }
            },
            {
              "created_by": {
                "$in": [
                  "clauorenstein@gmail.com",
                  "quiclauorenstein@gmail.com",
                  "testeclauorenstein@gmail.com"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "email": "testeclauorenstein@gmail.com"
              }
            },
            {
              "created_by": {
                "$in": [
                  "clauorenstein@gmail.com",
