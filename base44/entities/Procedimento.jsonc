                "$in": [
                  "clauorenstein@gmail.com",
                  "quiclauorenstein@gmail.com",
                  "testeclauorenstein@gmail.com"
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
