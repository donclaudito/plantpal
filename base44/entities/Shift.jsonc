{
  "name": "Shift",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do plant\u00e3o"
    },
    "doctor_id": {
      "type": "string",
      "description": "ID do m\u00e9dico"
    },
    "doctor_name": {
      "type": "string",
      "description": "Nome do m\u00e9dico"
    },
    "hospital": {
      "type": "string",
      "description": "Nome do hospital"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "DIURNO MANH\u00c3",
        "DIURNO TARDE",
        "Diurno",
        "Noturno",
        "24h"
      ],
      "description": "Tipo de plant\u00e3o"
    },
    "period": {
      "type": "string",
      "enum": [
        "12h",
        "6h",
        "retaguarda",
        "mais tarde"
      ],
      "default": "12h",
      "description": "Per\u00edodo do plant\u00e3o"
    },
    "value": {
      "type": "number",
      "description": "Valor do plant\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Realizado",
        "Cancelado",
        "Pago"
      ],
      "default": "Realizado",
      "description": "Status do plant\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "date",
    "doctor_name",
    "hospital",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
