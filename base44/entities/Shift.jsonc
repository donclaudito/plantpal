{
  "name": "Shift",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do plant\u00e3o"
    },
    "doctor_id": {
      "type": "string",
      "description": "ID do m\u00e9dico"
    },
    "doctor_name": {
      "type": "string",
      "description": "Nome do m\u00e9dico"
    },
    "hospital": {
      "type": "string",
      "description": "Nome do hospital"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "DIURNO MANH\u00c3",
        "DIURNO TARDE",
        "Diurno",
        "Noturno",
        "24h"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "gray",
        "pink"
      ],
      "description": "Tipo de plant\u00e3o"
    },
    "period": {
      "type": "string",
      "enum": [
        "consultas",
        "1h",
        "2h",
        "3h",
        "4h",
        "5h",
        "6h",
        "12h",
        "24h",
        "retaguarda",
        "mais tarde",
        "coordenador",
        "professor"
      ],
      "enumColors": [
        "green",
        "blue",
        "blue",
        "blue",
        "blue",
        "blue",
        "blue",
        "purple",
        "pink",
        "gray",
        "yellow",
        "yellow",
        "yellow"
      ],
      "default": "12h",
      "description": "Identifica\u00e7\u00e3o do per\u00edodo, nunca usada para calcular valor por hora"
    },
    "value": {
      "type": "number",
      "description": "Valor l\u00edquido do plant\u00e3o ap\u00f3s descontos percentuais"
    },
    "usar_valor_informado": {
      "type": "boolean",
      "default": false,
      "description": "Usa o valor real informado em vez da estimativa configurada"
    },
    "valor_bruto_informado": {
      "type": "number",
      "minimum": 0,
      "description": "Valor bruto real deste per\u00edodo de consultas, sem rela\u00e7\u00e3o com a dura\u00e7\u00e3o"
    },
    "quantidade_consultas": {
      "type": "number",
      "minimum": 0,
      "description": "Quantidade de consultas realizadas no per\u00edodo (manh\u00e3 ou tarde)"
    },
    "valor_consulta": {
      "type": "number",
      "minimum": 0,
      "description": "Valor bruto de cada consulta"
    },
    "status": {
      "type": "string",
      "enum": [
        "Realizado",
        "Cancelado",
        "Pago"
      ],
      "enumColors": [
        "blue",
        "red",
        "green"
      ],
      "default": "Realizado",
      "description": "Status do plant\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "date",
    "doctor_name",
    "hospital",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "quiclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}