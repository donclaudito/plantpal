          }
        },
        {
          "user_condition": {
            "email": "testeclauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "clauorenstein@gmail.com"
          }
        },
        {
          "user_condition": {
