{
  "name": "ConfiguracaoPlantao",
  "type": "object",
  "properties": {
    "doctor_id": {
      "type": "string",
      "description": "ID do m\u00e9dico (opcional, se vazio aplica-se globalmente)"
    },
    "hospital_id": {
      "type": "string",
      "description": "ID do hospital (opcional, se vazio aplica-se globalmente)"
    },
    "tipo_calculo": {
      "type": "string",
      "enum": [
        "por_plantao",
        "por_periodo",
        "por_cirurgia"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "description": "Valor fixo por tipo de plant\u00e3o, estimativa por per\u00edodo de consultas ou valor por cirurgia realizada no conv\u00eanio"
    },
    "valor_periodo": {
      "type": "number",
      "minimum": 0,
      "description": "Estimativa bruta por per\u00edodo de consultas, independente da dura\u00e7\u00e3o"
    },
    "valor_cirurgia": {
      "type": "number",
      "minimum": 0,
      "description": "Valor pago por cirurgia realizada no conv\u00eanio"
    },
    "valor_6h": {
      "type": "number",
      "description": "Valor integral do plant\u00e3o identificado como 6h, sem proporcionalidade"
    },
    "valor_12h": {
      "type": "number",
      "description": "Valor integral do plant\u00e3o identificado como 12h, sem proporcionalidade"
    },
    "valor_retaguarda": {
      "type": "number",
      "description": "Valor para plant\u00e3o de retaguarda"
    },
    "valor_coordenador": {
      "type": "number",
      "description": "Valor para coordenador"
    },
    "valor_professor": {
      "type": "number",
      "description": "Valor para professor"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}